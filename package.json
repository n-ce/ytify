{
  "name": "ytify",
  "version": "8.5-Ultra",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "bun test scripts/",
    "validate": "bun lint ; bun check ; bun fmt ; knip --ignore 'netlify'",
    "build": "bun run scripts/generate-icons.ts && tsc && vite build"
  },
  "knip": {
    "ignore": [
      "netlify/**"
    ]
  },
  "dependencies": {
    "solid-js": "^1.9.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@netlify/blobs": "^11.1.9",
    "@netlify/edge-functions": "^4.0.4",
    "@netlify/functions": "^6.1.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/subset-font": "^2.3.0",
    "autoprefixer": "^10.6.2",
    "knip": "^6.45.1",
    "open-props": "1.7.23",
    "postcss-jit-props": "1.0.16",
    "remixicon": "^4.9.1",
    "subset-font": "^2.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-solid": "^2.11.16",
    "youtubei.js": "18.3.0"
  },
  "overrides": {
    "glob": "^14.0.5",
    "minimatch": "^11.0.8",
    "deepmerge": "npm:@stackline/deepmerge@^1.1.0"
